{
	"name": "wired-for-scale",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6",
	"scripts": {
		"dev": "turbo run dev",
		"dev:web": "turbo run dev --filter=@wfs/web",
		"build": "turbo run build",
		"start": "turbo run start",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"format": "turbo run format",
		"format:check": "turbo run format:check",
		"type-check": "turbo run type-check",
		"knip": "knip",
		"knip:production": "knip --production",
		"knip:fix": "knip --fix",
		"clean": "turbo run clean && rm -rf node_modules .turbo apps/*/.turbo packages/*/.turbo && find . -name '*.tsbuildinfo' -not -path '*/node_modules/*' -delete",
		"clean:install": "pnpm clean && pnpm install",
		"precommit": "turbo run type-check lint",
		"ci": "pnpm install --frozen-lockfile && turbo run type-check lint build",
		"deps:update": "pnpm update --interactive --latest -r",
		"deps:check": "pnpm outdated",
		"prepare": "git config core.hooksPath .githooks"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@types/node": "25.9.1",
		"knip": "6.16.1",
		"turbo": "2.9.16"
	},
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=10.26.2"
	}
}
