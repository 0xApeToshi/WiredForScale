{
    "name": "@wfs/design-tokens",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./tokens.css": "./src/tokens.css"
    },
    "files": [
        "src"
    ],
    "scripts": {
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf .turbo *.tsbuildinfo"
    },
    "devDependencies": {
        "@wfs/biome-config": "workspace:*",
        "@wfs/typescript-config": "workspace:*",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=10.26.2"
    }
}
