{
    "name": "@wfs/web",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3000 --turbopack",
        "build": "next build",
        "start": "next start -p 3000",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "type-check": "tsc --noEmit",
        "clean": "rm -rf .next out dist node_modules *.tsbuildinfo",
        "deps:update": "pnpm update --interactive --latest",
        "deps:check": "pnpm outdated"
    },
    "dependencies": {
        "@vercel/analytics": "2.0.1",
        "@vercel/speed-insights": "2.0.0",
        "@wfs/design-tokens": "workspace:*",
        "gray-matter": "4.0.3",
        "next": "16.3.4",
        "next-mdx-remote": "6.0.0",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "reading-time": "1.5.0",
        "rehype-autolink-headings": "7.1.0",
        "rehype-slug": "6.0.0",
        "remark-gfm": "4.0.1",
        "remark-smartypants": "3.0.2",
        "tailwindcss": "4.3.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.3.0",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@wfs/biome-config": "workspace:*",
        "@wfs/typescript-config": "workspace:*",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=10.26.2"
    }
}
